/* DataWarden - Main TCSS Stylesheet */
/* =============================================================================
   Base Styles - Theming handled by ThemeManager via dynamic CSS
   ============================================================================= */

Screen {
    /* Base colors - overridden by ThemeManager.apply_theme() */
    background: #1e1e2e;
    color: #f8f8f2;
}

/* =============================================================================
   Layout & Containers
   ============================================================================= */

#main-container {
    layout: horizontal;
    height: 1fr;
}

#sidebar {
    width: 25;
    height: 1fr;
    background: #282a36;
    border-right: solid #44475a;
    padding: 1;
    overflow-y: auto;
}

#content-area {
    width: 1fr;
    height: 1fr;
    background: #1e1e2e;
}

.screen {
    height: 1fr;
    overflow-y: auto;
    padding: 1;
}

.screen.hidden {
    display: none;
}

/* =============================================================================
   Navigation Sidebar
   ============================================================================= */

#app-title {
    text-style: bold;
    color: #bd93f9;
    text-align: center;
    margin-bottom: 0;
}

#app-subtitle {
    color: #6272a4;
    text-align: center;
    margin-bottom: 2;
}

.nav-button {
    width: 100%;
    margin: 1 0;
    background: transparent;
    border: solid #44475a;
    color: #f8f8f2;
}

.nav-button:hover {
    background: #bd93f9;
    color: #1e1e2e;
}

.nav-button.active {
    background: #bd93f9;
    color: #1e1e2e;
    border: solid #50fa7b;
}

/* =============================================================================
   Forms & Inputs
   ============================================================================= */

.screen-title {
    text-style: bold;
    color: #bd93f9;
    margin-bottom: 1;
}

.screen-description {
    color: #6272a4;
    margin-bottom: 2;
}

.section-title {
    text-style: bold;
    color: #50fa7b;
    margin: 2 0 1 0;
}

.form-group {
    margin: 1 0;
}

.form-row {
    layout: horizontal;
    height: auto;
}

.half {
    width: 1fr;
}

Label {
    color: #f8f8f2;
    margin-bottom: 1;
}

Input {
    background: #282a36;
    border: solid #44475a;
    color: #f8f8f2;
}

Input:focus {
    border: solid #bd93f9;
}

Select {
    background: #282a36;
    border: solid #44475a;
    color: #f8f8f2;
}

Select:focus {
    border: solid #bd93f9;
}

.button-row {
    layout: horizontal;
    margin-top: 2;
}

.button-row Button {
    margin-right: 1;
}

/* =============================================================================
   Progress Area
   ============================================================================= */

.progress-area {
    margin-top: 2;
    padding: 1;
    background: #282a36;
    border: solid #44475a;
}

.progress-area.hidden {
    display: none;
}

.progress-line {
    color: #f8f8f2;
    margin: 0;
}

.progress-line.warning {
    color: #ffb86c;
}

.progress-line.error {
    color: #ff5555;
}

/* =============================================================================
   Results Areas
   ============================================================================= */

.results-area {
    margin-top: 2;
}

.results-area.hidden {
    display: none;
}

/* =============================================================================
   Commander / File Manager
   ============================================================================= */

#commander-panes {
    layout: horizontal;
    height: 1fr;
}

.commander-pane {
    width: 1fr;
    height: 1fr;
    border: solid #44475a;
}

.hint-bar {
    color: #6272a4;
    text-align: center;
    margin-bottom: 1;
    padding: 1;
    background: #282a36;
    border: solid #44475a;
}

.panel {
    height: 20;
    border: solid #44475a;
    background: #282a36;
}

.panel.hidden {
    display: none;
}

/* =============================================================================
   DataTable Styling
   ============================================================================= */

DataTable {
    background: #282a36;
    color: #f8f8f2;
}

DataTable > .datatable--header {
    background: #bd93f9;
    color: #1e1e2e;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #50fa7b;
    color: #1e1e2e;
}

DataTable > .datatable--even-row {
    background: #282a36;
}

DataTable > .datatable--odd-row {
    background: #1e1e2e;
}

/* =============================================================================
   RichLog / Log Panel
   ============================================================================= */

RichLog {
    background: #282a36;
    color: #f8f8f2;
    border: solid #44475a;
}

/* =============================================================================
   Modals
   ============================================================================= */

.modal-screen {
    align: center middle;
}

.modal-container {
    width: 80;
    max-width: 100;
    height: auto;
    max-height: 80%;
    background: #282a36;
    border: thick #bd93f9;
    padding: 2;
    overflow-y: auto;
}

.modal-title {
    text-style: bold;
    color: #ff5555;
    text-align: center;
    margin-bottom: 1;
}

.modal-warning {
    color: #ffb86c;
    text-style: bold;
    margin: 1 0;
}

.modal-text {
    color: #f8f8f2;
    margin: 1 0;
}

.modal-hotkey {
    color: #50fa7b;
    text-style: bold;
    margin: 1 0;
}

.modal-buttons {
    layout: horizontal;
    margin-top: 2;
}

.modal-buttons Button {
    margin: 0 1;
}

/* =============================================================================
   Status Bar
   ============================================================================= */

Footer {
    background: #282a36;
    color: #f8f8f2;
    border-top: solid #44475a;
}

/* =============================================================================
   Tree Widget
   ============================================================================= */

Tree {
    background: #282a36;
    color: #f8f8f2;
}

Tree > .tree--cursor {
    background: #bd93f9;
    color: #1e1e2e;
}

Tree > .tree--guides {
    color: #44475a;
}

/* =============================================================================
   Collapsible
   ============================================================================= */

Collapsible {
    border: solid #44475a;
    background: #282a36;
}

Collapsible > .collapsible--title {
    background: #bd93f9;
    color: #1e1e2e;
    text-style: bold;
}

/* =============================================================================
   TabbedContent
   ============================================================================= */

TabbedContent {
    background: #282a36;
}

TabbedContent > .tabbed-content--tabs {
    background: #1e1e2e;
    border-bottom: solid #44475a;
}

TabbedContent > .tabbed-content--tabs Button {
    color: #6272a4;
}

TabbedContent > .tabbed-content--tabs Button.-active {
    color: #bd93f9;
    text-style: bold;
    border-bottom: solid #bd93f9;
}

/* =============================================================================
   Special Colors for Status
   ============================================================================= */

.reference-file {
    color: #50fa7b;
    text-style: bold;
}

.warning-text {
    color: #ffb86c;
}

.error-text {
    color: #ff5555;
}

.ai-auto-text {
    color: #8be9fd;
}

/* =============================================================================
   Progress Bar
   ============================================================================= */

ProgressBar {
    background: #282a36;
    color: #50fa7b;
}

ProgressBar > .progress-bar--bar {
    background: #bd93f9;
}

/* =============================================================================
   Sparkline
   ============================================================================= */

Sparkline {
    color: #50fa7b;
}

/* =============================================================================
   Scrollbar
   ============================================================================= */

Scrollbar {
    background: #1e1e2e;
    color: #bd93f9;
}

/* =============================================================================
   Selection
   ============================================================================= */

.selected {
    background: #bd93f9;
    color: #1e1e2e;
}

/* =============================================================================
   Focus Styles
   ============================================================================= */

*:focus {
    border: solid #bd93f9;
}

/* =============================================================================
   Pulsing (handled via Textual animation API, not CSS keyframes)
   ============================================================================= */

.pulsing {
    opacity: 0.5;
}

/* EOF */